{
  "name": "kasir-bisa-web",
  "private": true,
  "scripts": {
    "build": "node -e \"console.log('No framework build step: static files are in src/')\"",
    "deploy": "wrangler pages deploy src --project-name kasirbisa",
    "dev": "wrangler pages dev src --env-file .dev.vars",
    "d1:migrate": "wrangler d1 migrations apply kasirbisa",
    "d1:migrate:local": "wrangler d1 migrations apply kasirbisa --local",
    "d1:migrate:remote": "wrangler d1 migrations apply kasirbisa --remote"
  },
  "devDependencies": {
    "wrangler": "^4.165.0"
  }
}
